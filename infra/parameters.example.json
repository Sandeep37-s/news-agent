{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {"value":"YOUR-CONTAINER-APPS-ENVIRONMENT"},
    "identityName": {"value":"YOUR-USER-ASSIGNED-IDENTITY"},
    "registryServer": {"value":"YOUR-REGISTRY.azurecr.io"},
    "backendImage": {"value":"YOUR-REGISTRY.azurecr.io/drishti-api:v1"},
    "frontendImage": {"value":"YOUR-REGISTRY.azurecr.io/drishti-web:v1"},
    "keyVaultUri": {"value":"https://YOUR-VAULT.vault.azure.net/"},
    "dashboardUrl": {"value":"https://YOUR-DASHBOARD-HOST"},
    "cronExpression": {"value":"0 * * * *"}
  }
}
