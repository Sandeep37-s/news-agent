# Generate a long random password; never commit .env
ADMIN_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
DASHBOARD_URL=http://localhost:3000
